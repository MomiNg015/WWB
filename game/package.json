{
  "name": "game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "backup": "tsx server/backup.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "concurrently -k \"npm run server\" \"npm run dev -- --host 127.0.0.1 --port 5173 --strictPort\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "express": "^5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "6.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
